# Copy this file to .env and add your Gemini API key.
# Without a key TalkGrade uses its built-in offline rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
TEAM_MODE=0
# Production behind a TLS-terminating proxy: keep the session cookie Secure (default in NODE_ENV=production).
# COOKIE_SECURE=1
# Optional; defaults to server/talkgrade-team.sqlite when TEAM_MODE=1.
# TEAM_DB=
